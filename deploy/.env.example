# =============================================================================
# Example environment for the containerized audit binding (Path C).
# Copy to `deploy/.env` only for local experimentation.  Never commit `.env`.
# No real credential belongs in this file.
# =============================================================================

# Image tag and host port.
LAD_IMAGE_TAG=audit
LAD_PORT=8080
LAD_SERVICE_VERSION=1.0.0-audit
LAD_LOG_LEVEL=INFO

# Request / buffer bounds (all fail closed; none silently truncate a verdict).
LAD_MAX_REQUEST_BYTES=8388608
LAD_MAX_EVENTS_PER_REQUEST=5000
LAD_MAX_BUFFER_EVENTS=250000
LAD_MAX_WINDOWS_PER_REQUEST=50000
LAD_MAX_INCIDENTS_IN_RESPONSE=50
LAD_MAX_RECORDS_IN_RESPONSE=500

# Artifact paths inside the container.  The files are bind-mounted read-only
# from ../artifacts by docker-compose.yml; they are not baked into the image.
LAD_MODEL_PATH=/app/artifacts/network/model/model.joblib
LAD_MANIFEST_PATH=/app/artifacts/network/model/manifest.json
LAD_NETWORK_CONFIG=/app/configs/network.yaml
LAD_CORRELATION_CONFIG=/app/configs/correlation.yaml

# Correlation.  Explanations are optional and never change the ML decision.
LAD_CORRELATION_WINDOW_SECONDS=120
LAD_CORRELATION_REQUIRE_EVENT_EVIDENCE=true
LAD_CORRELATION_EXPLAIN=false

# Explanation provider boundary.
#   none  -> explanations disabled
#   mock  -> in-process deterministic provider (default; clearly labelled)
#   http  -> real HTTP transport to LAD_LLM_ENDPOINT (local mock or external)
LAD_LLM_PROVIDER=mock
LAD_LLM_ENDPOINT=http://mock-llm:8081/v1/chat/completions
LAD_LLM_MODEL=lad-grounded-mock-v1
LAD_LLM_TIMEOUT_SECONDS=20

# The *name* of the environment variable that holds the API key.  The value
# must be supplied at runtime (e.g. `LAD_LLM_API_KEY=... docker compose up`)
# and must never be written to this file or to git.
LAD_LLM_API_KEY_ENV=LAD_LLM_API_KEY

# To exercise the real HTTP transport against the local deterministic provider:
#   LAD_LLM_PROVIDER=http
#   LAD_CORRELATION_EXPLAIN=true
#   docker compose --profile mock-llm up --build -d
#
# For an explicitly authorized external provider, set LAD_LLM_ENDPOINT and
# export LAD_LLM_API_KEY in the shell.  No external provider is contacted by
# default, and no real-provider run is claimed in the audit report.
