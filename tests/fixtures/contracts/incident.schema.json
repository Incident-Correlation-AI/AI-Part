{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/schemas/incident.schema.json",
  "title": "Incident",
  "description": "Correlated anomaly record. Observations, hypotheses, and recommendations stay structurally separate.",
  "type": "object",
  "required": [
    "incident_id",
    "schema_version",
    "status",
    "severity",
    "affected_entities",
    "anomaly_score",
    "detector",
    "evidence",
    "hypotheses",
    "diagnostic_checks",
    "created_at",
    "updated_at",
    "audit"
  ],
  "additionalProperties": true,
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "status": {
      "type": "string",
      "enum": ["open", "acknowledged", "resolved"],
      "description": "Lifecycle state. Reopen is a transition back to open (recorded in audit), not a fourth status."
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Estimated operational impact (rule-based). Distinct from event severity and from anomaly_score."
    },
    "affected_entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["host"],
        "additionalProperties": true,
        "properties": {
          "host": { "type": "string", "maxLength": 255 },
          "service": { "type": ["string", "null"], "maxLength": 255 },
          "source": { "type": ["string", "null"], "maxLength": 64 }
        }
      }
    },
    "anomaly_score": {
      "type": "number",
      "description": "Detector-specific unusualness (e.g. robust z-score). NOT a probability."
    },
    "detector": {
      "type": "string",
      "description": "Which detector produced the score, e.g. statistical_baseline, isolation_forest."
    },
    "model_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end"],
        "additionalProperties": false,
        "properties": {
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["supporting_event_ids", "contradicting_event_ids"],
      "additionalProperties": false,
      "description": "Both arrays required — a record citing only supporting evidence is not honest.",
      "properties": {
        "supporting_event_ids": {
          "type": "array",
          "items": { "type": "string", "maxLength": 128 }
        },
        "contradicting_event_ids": {
          "type": "array",
          "items": { "type": "string", "maxLength": 128 }
        },
        "redacted_refs": {
          "type": "array",
          "items": { "type": "string", "maxLength": 512 }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "description": "Explanations. 'Unknown' is a valid statement, with missing_evidence explaining what would be needed.",
      "items": {
        "type": "object",
        "required": [
          "statement",
          "confidence",
          "supporting_event_ids",
          "contradicting_event_ids",
          "missing_evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "statement": { "type": "string", "maxLength": 2048 },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high", "unknown"],
            "description": "Strength of support — NOT a probability."
          },
          "supporting_event_ids": {
            "type": "array",
            "items": { "type": "string", "maxLength": 128 }
          },
          "contradicting_event_ids": {
            "type": "array",
            "items": { "type": "string", "maxLength": 128 }
          },
          "missing_evidence": {
            "type": "array",
            "items": { "type": "string", "maxLength": 1024 }
          }
        }
      }
    },
    "diagnostic_checks": {
      "type": "array",
      "description": "Recommendations only. executes is structurally false — the contract encodes non-execution.",
      "items": {
        "type": "object",
        "required": ["instruction", "evidence_links", "executes"],
        "additionalProperties": false,
        "properties": {
          "instruction": { "type": "string", "maxLength": 2048 },
          "evidence_links": {
            "type": "array",
            "items": { "type": "string", "maxLength": 128 }
          },
          "executes": { "type": "boolean", "const": false }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "audit": {
      "type": "array",
      "description": "Append-only. Lifecycle actions are never silent mutations.",
      "items": {
        "type": "object",
        "required": ["action", "actor", "at"],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": ["acknowledged", "resolved", "reopened"]
          },
          "actor": { "type": "string", "maxLength": 255 },
          "at": { "type": "string", "format": "date-time" },
          "note": { "type": ["string", "null"], "maxLength": 1024 }
        }
      }
    }
  }
}

